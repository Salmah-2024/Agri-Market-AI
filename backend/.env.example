# Copy to backend/.env and fill in.

# MongoDB connection string. Local server shown; for Atlas paste your string.
# If MongoDB is unreachable the app warns and uses a temporary in-memory DB
# (data not saved) so it still runs. Leave empty to force in-memory.
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=agri_market_ai

# Long random string used to sign login tokens. Set this in production.
JWT_SECRET=change-me

# Key for POST /api/admin/gov-prices (adding official Ministry prices)
ADMIN_KEY=change-me-too

# Optional: a CSV (crop,region,price,date) with official prices, imported daily at 00:05 EAT
GOV_PRICES_CSV_URL=

# Load the demo farmer/buyer accounts into MongoDB too (1 = yes)
SEED_DEMO=1

# Crops to serve (the 7 Ministry-bulletin crops). Trim this list to show fewer.
ACTIVE_CROPS=Maize,Rice,Beans,Sorghum,Bulrush Millet,Finger Millet,Round Potato

# Allowed frontend origins for the API (comma separated)
CORS_ORIGINS=*
